#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        ha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <8 9>;
        };

        ee {
            bindings = <&kp RU_CYRILLIC_E>;
            key-positions = <20 21>;
        };

        hs {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <34 35>;
        };

        nav-l_shift {
            bindings = <&mo 4>;
            key-positions = <39 40>;
            layers = <0>;
        };
    };

    behaviors {
        tap_sl_hold_kp: tap_sl_hold_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_SL_HOLD_KP";
            bindings = <&kp>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hold_tap_lang: hold_tap_lang {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_LANG";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
        };
    };

    macros {
        lang_ru: lang_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(LS(NUMBER_2))>,
                <&macro_press>,
                <&mo 1>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>;

            label = "LANG_RU";
        };

        lang_en: lang_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LC(LS(N1))>,
                <&macro_press>,
                <&mo 2>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>;

            label = "LANG_EN";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        lang_en2: lang_en2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(LS(N1))>,
                <&macro_release>,
                <&kp LC(LS(N1))>,
                <&macro_press>,
                <&mo 2>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>;

            label = "LANG_EN2";
            wait-ms = <0>;
            tap-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp LS(LC(F7))  &kp Q  &kp W  &kp E  &kp R       &kp T                                                      &kp Y      &kp U       &kp I      &kp O    &kp P      &trans
&trans          &kp A  &kp S  &kp D  &kp F       &kp G                                                      &kp H      &kp J       &kp K      &kp L    &kp SEMI   &kp LGUI
&trans          &kp Z  &kp X  &kp C  &kp V       &kp B                              &trans       &trans     &kp N      &kp M       &kp COMMA  &kp DOT  &kp SLASH  &trans
                                     &kp LSHIFT  &hold_tap_lang 1 LS(LC(NUMBER_2))  &kp SPACE    &kp SPACE  &lang_en2  &kp RSHIFT
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
&trans  &kp LG(TAB)  &kp LA(F4)  &kp LC(W)   &kp LA(R)  &kp LA(T)                           &kp HOME         &kp UP        &kp DOWN  &kp LC(T)    &trans  &trans
&trans  &kp ESC      &kp F3      &kp DELETE  &kp LA(F)  &kp LA(LS(K))                       &kp LS(LC(TAB))  &kp F20       &kp F21   &kp LC(TAB)  &trans  &trans
&trans  &kp LC(Z)    &kp LC(X)   &kp LC(C)   &kp LC(V)  &kp LEFT       &trans    &trans     &kp LA(N)        &kp LC(SEMI)  &kp END   &kp RIGHT    &trans  &trans
                                             &trans     &trans         &trans    &lt 5 TAB  &trans           &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans  &kp LG(TAB)  &trans         &kp LC(RA(E))  &trans         &kp LC(RA(T))                    &trans                &trans     &kp LC(RA(I))  &kp LC(RA(O))  &sk LEFT_ALT   &trans
&trans  &trans       &kp LC(RA(S))  &kp LC(RA(D))  &kp LC(RA(C))  &trans                           &sk LG(LC(NUMBER_9))  &kp ENTER  &kp BACKSPACE  &kp F1         &sk LCTRL      &trans
&trans  &trans       &trans         &kp LC(RA(C))  &kp LC(RA(V))  &trans         &trans    &trans  &trans                &trans     &trans         &kp F1         &sk LS(LCTRL)  &trans
                                                   &trans         &trans         &trans    &trans  &trans                &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&trans  &sys_reset   &kp F1  &kp F2   &kp F3   &kp F4                     &trans        &trans         &trans            &trans      &bt BT_SEL 4  &bt BT_CLR
&trans  &trans       &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp LC(ENTER)  &kp C_MUTE        &trans      &sk LALT      &studio_unlock
&trans  &bootloader  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV     &kp C_PLAY_PAUSE  &kp C_NEXT  &trans        &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        four {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans        &trans         &trans  &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                          &kp LA(LEFT)  &trans         &trans  &kp LA(RIGHT)  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans        &trans         &trans  &trans         &trans  &trans
                                &trans  &trans  &trans    &kp LA(LEFT)  &trans        &kp LA(RIGHT)
            >;

            label = "FOUR";
        };

        r_space {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &kp PRINTSCREEN  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans           &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "RigthSpace";
        };

        l_space {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "LeftSpace";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        cond_Adj {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
